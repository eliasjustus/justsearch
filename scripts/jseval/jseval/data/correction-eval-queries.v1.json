{
  "_meta": {
    "schema": "correction-eval-queries.v1",
    "consumer": "jseval.correction_probe.load_manifest",
    "purpose": "Seeded spell-correction probe manifest: generic everyday queries with deterministically-derived misspellings, so the correction feature has a working eval (tempdoc 787 item 3).",
    "leak_avoidance": "Clean queries are generic consumer/everyday phrases (cooking, travel, weather, consumer electronics). None are drawn from any committed eval corpus (beir/scifact=academic, mixed/enron-qa=email, mixed/legal-clerc-200=case-law, mixed/miracl-*=wikipedia factoid, mixed/cord19-qddf=biomedical). expected_correction carries only the corrected query spelling — never a doc id, qrel key, or gold answer — so this manifest cannot leak any corpus's answer key.",
    "derivation": {
      "correct_spelling": "control: the clean query verbatim; expected_correction=null (no correction expected).",
      "typo": "single-character deletion or substitution in exactly one word of the clean query.",
      "transposition": "swap of two adjacent characters in exactly one word of the clean query.",
      "missing_space": "the space between two adjacent words removed (word-boundary error).",
      "note": "expected_correction is always the full clean query the misspelling was derived from (matching classify()'s full-query comparison)."
    }
  },
  "queries": [
