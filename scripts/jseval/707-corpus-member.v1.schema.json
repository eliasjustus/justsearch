{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "707-corpus-member.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "language", "domain", "real_source", "gold_source", "assembly", "sizes", "query_variants", "claim_eligible", "remaining_gates"],
  "properties": {
    "schema": {"const": "707-corpus-member.v1"},
    "name": {"type": "string"},
    "language": {"type": "string"},
    "domain": {"enum": ["legal", "email", "encyclopedic"]},
    "real_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "content_scope", "license", "license_status", "redistribute"],
      "properties": {
        "recipe": {"type": "string"},
        "content_scope": {"type": "string"},
        "license": {"type": ["string", "null"]},
        "license_status": {"enum": ["verified", "unresolved"]},
        "redistribute": {"const": false}
      }
    },
    "gold_source": {"type": "string"},
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "style", "seed", "host_min_words"],
      "properties": {
        "command": {"const": "jseval corpus-inject-real"},
        "style": {"enum": ["append", "interleave"]},
        "seed": {"type": "integer"},
        "host_min_words": {"type": "integer", "minimum": 1}
      }
    },
    "sizes": {"type": "array", "items": {"type": "integer", "minimum": 1000}, "minItems": 2},
    "query_variants": {"type": "array", "items": {"enum": ["verbose", "short-natural"]}, "minItems": 2},
    "claim_eligible": {"type": "boolean"},
    "remaining_gates": {"type": "array", "items": {"type": "string"}}
  }
}
