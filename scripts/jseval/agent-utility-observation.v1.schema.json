{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-utility-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "condition", "seed", "qid", "attempted", "excluded",
    "error_class", "attempts", "first_error_class", "correct", "cost_usd",
    "provider_usage", "provider_model_usage", "provider_cache_creation_input_tokens",
    "resolved_provider_model", "num_turns", "tool_call_names",
    "blocked_tool_call_names", "disallowed_tool_call_names", "leak_suspect",
    "mcp_server_statuses", "mcp_tools_offered", "mcp_surface_unverified",
    "mcp_tools_deferred", "source"
  ],
  "properties": {
    "schema": {"const": "agent-utility-observation.v1"},
    "condition": {"enum": ["A", "B", "C"]},
    "seed": {"type": "integer", "minimum": 0},
    "qid": {"type": "string", "minLength": 1},
    "attempted": {"const": true},
    "excluded": {"type": "boolean"},
    "error_class": {"type": ["string", "null"]},
    "attempts": {"type": ["integer", "null"], "minimum": 0},
    "first_error_class": {"type": ["string", "null"]},
    "correct": {"type": "boolean"},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "provider_usage": {"type": "object"},
    "provider_model_usage": {"type": "object"},
    "provider_cache_creation_input_tokens": {"type": ["integer", "number", "null"], "minimum": 0},
    "resolved_provider_model": {"type": ["string", "null"]},
    "num_turns": {"type": ["integer", "null"], "minimum": 0},
    "tool_call_names": {"type": ["array", "null"], "items": {"type": "string"}},
    "blocked_tool_call_names": {"type": ["array", "null"], "items": {"type": "string"}},
    "disallowed_tool_call_names": {"type": ["array", "null"], "items": {"type": "string"}},
    "leak_suspect": {"type": "boolean"},
    "mcp_server_statuses": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {"name": {"type": "string"}, "status": {"type": "string"}}
      }
    },
    "mcp_tools_offered": {"type": ["integer", "null"], "minimum": 0},
    "mcp_tool_names_offered": {
      "type": ["array", "null"],
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "observed_mcp_tool_surface_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "mcp_surface_unverified": {"type": "boolean"},
    "mcp_tools_deferred": {"type": ["boolean", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_alias", "corpus", "packages", "source_git_sha", "source_git_dirty",
        "cli_version", "mcp_tool_surface_hash", "judge_kind", "prompt_template_hash",
        "decoding", "eval_limits", "search_config_cohort_key", "environment",
        "corpus_identity"
      ],
      "properties": {
        "model_alias": {"type": ["string", "null"]},
        "corpus": {"type": "object"},
        "packages": {"type": ["object", "array"]},
        "source_git_sha": {"type": ["string", "null"]},
        "source_git_dirty": {"type": ["boolean", "null"]},
        "cli_version": {"type": ["string", "null"]},
        "mcp_tool_surface_hash": {"type": ["string", "null"]},
        "judge_kind": {"type": ["string", "null"]},
        "prompt_template_hash": {"type": ["string", "null"]},
        "decoding": {"type": "object"},
        "eval_limits": {"type": "object"},
        "search_config_cohort_key": {"type": ["string", "null"]},
        "environment": {"type": ["object", "null"]},
        "corpus_identity": {"type": ["object", "null"]}
      }
    }
  }
}
