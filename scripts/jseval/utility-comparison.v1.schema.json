{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "utility-comparison.v1",
  "title": "Agent-utility comparison record (tempdoc 624)",
  "description": "Condition-paired sibling of the 623 benchmark release. Projects over agent-eval runs cohort-identical on every axis except `condition` (with-tool vs. without-tool), one cell per (corpus, agent_model), aggregating over seed. A separate canonical record, NOT a metric family inside the single-cohort 623 release.",
  "type": "object",
  "required": ["schema", "schema_version", "composed_at", "cohort", "measured", "coverage", "comparability", "tool_call_assertions", "estimands", "statistical_alpha", "claim_verdict", "semantic_digest"],
  "additionalProperties": true,
  "definitions": {
    "armLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_expected", "n_attempted", "n_completed", "n_excluded", "n_pending", "exclusion_rate"],
      "properties": {
        "n_expected": {"type": "integer", "minimum": 0},
        "n_attempted": {"type": "integer", "minimum": 0},
        "n_completed": {"type": "integer", "minimum": 0},
        "n_excluded": {"type": "integer", "minimum": 0},
        "n_pending": {"type": "integer", "minimum": 0},
        "exclusion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "n_exhausted": {"type": "integer", "minimum": 0, "description": "tempdoc 624 (2026-07-17): resource-exhaustion cells (scored-incorrect, retained). Omitted on records with no exhausted cells."}
      }
    },
    "ittStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id", "corpus_member", "corpus", "corpus_size", "query_variant",
        "corpus_signature", "model", "resolved_provider_model", "query_identity",
        "campaign_identity", "corpus_certification", "seed_ids", "seed_count",
        "query_count", "n_expected_cells", "n_observed_cells", "n_pending_cells",
        "n_expected_pairs", "n_paired_observations", "n_per_protocol_pairs",
        "paired_retention", "excluded_jaccard", "per_arm_loss", "usage_complete",
        "accuracy", "provider_cache_creation_input_tokens", "cost_usd", "adoption"
      ],
      "properties": {
        "stratum_id": {"type": ["string", "null"]},
        "corpus_member": {"type": ["string", "null"]},
        "corpus": {"type": ["string", "null"]},
        "corpus_size": {"type": ["integer", "null"], "minimum": 1},
        "query_variant": {"type": ["string", "null"]},
        "corpus_signature": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "resolved_provider_model": {"type": ["string", "null"]},
        "query_identity": {"type": ["object", "null"]},
        "campaign_identity": {"type": ["object", "null"]},
        "corpus_certification": {"type": ["object", "null"]},
        "seed_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "seed_count": {"type": "integer", "minimum": 0},
        "query_count": {"type": "integer", "minimum": 0},
        "n_expected_cells": {"type": "integer", "minimum": 0},
        "n_observed_cells": {"type": "integer", "minimum": 0},
        "n_pending_cells": {"type": "integer", "minimum": 0},
        "n_expected_pairs": {"type": "integer", "minimum": 0},
        "n_paired_observations": {"type": "integer", "minimum": 0},
        "n_per_protocol_pairs": {"type": "integer", "minimum": 0},
        "paired_retention": {"type": "number", "minimum": 0, "maximum": 1},
        "excluded_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
        "per_arm_loss": {
          "type": "object", "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {"A": {"$ref": "#/definitions/armLoss"}, "B": {"$ref": "#/definitions/armLoss"}}
        },
        "usage_complete": {"type": "boolean"},
        "accuracy": {"type": ["object", "null"]},
        "provider_cache_creation_input_tokens": {"type": ["object", "null"]},
        "cost_usd": {"type": ["object", "null"]},
        "adoption": {"type": "object"},
        "funnel": {"type": ["object", "null"]},
        "duration": {"type": ["object", "null"], "description": "tempdoc 624 (2026-07-17) duration metric family: per-arm wall-clock distribution + mandatory n_censored/completion_rate. Omitted when no paired cell carried a time."}
      }
    }
  },
  "properties": {
    "schema": { "const": "utility-comparison.v1" },
    "schema_version": { "const": 2 },
    "composed_at": { "type": "string", "description": "ISO timestamp (passed in; scripts can't call Date.now)." },
    "cohort": {
      "type": "object",
      "description": "The harness identity held fixed across the whole record (the agent_cohort_key surface). EXCLUDES corpus/model/condition/seed (range axes). The search_config_cohort_key co-varies with condition and is recorded here, not in the pairing key (R2).",
      "required": ["agent_cohort_key", "git_sha"],
      "properties": {
        "agent_cohort_key": { "type": "string", "description": "SHA over {git_sha, cli_version, mcp_tool_surface_hash, judge, prompt_template_hash, decoding, eval_limits}." },
        "git_sha": { "type": ["string", "null"] },
        "git_dirty": { "type": ["boolean", "null"] },
        "cli_version": { "type": ["string", "null"], "description": "Claude Code CLI version (HAL/Evaluation-Cards provenance: harness version)." },
        "mcp_tool_surface_hash": { "type": ["string", "null"], "description": "Hash of the tools/list payload the agent was offered (R8)." },
        "judge": { "type": "object", "description": "Hybrid scorer identity: {kind: substring-em | llm-judge, model?, version?, prompt_hash?}." },
        "prompt_template_hash": { "type": ["string", "null"] },
        "decoding": { "type": ["object", "null"], "description": "{temperature, max_tokens} (Evaluation-Cards agentic-minimal)." },
        "eval_limits": { "type": ["object", "null"], "description": "Per-query token/step/cost budget." },
        "search_config_cohort_key": { "type": ["string", "null"], "description": "623 config_cohort_key of the with-tool search backend (null for the without-tool arm)." },
        "hardware": { "type": ["object", "null"], "description": "Stable hardware projection (gpu/vram/driver/ort), reused from release._hardware_projection." },
        "environment": { "type": ["object", "null"] },
        "exposure_config": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enable_tool_search", "always_load", "exposure_mode"],
              "properties": {
                "enable_tool_search": {"type": ["string", "null"]},
                "always_load": {"type": ["boolean", "null"]},
                "exposure_mode": {"enum": ["eager", "deferred", "unknown"]}
              }
            }
          ]
        },
        "mcp_initialize_identity": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["instructions", "instructions_sha256", "server_version", "protocol_version"],
              "properties": {
                "instructions": {"type": ["string", "null"]},
                "instructions_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "server_version": {"type": ["string", "null"]},
                "protocol_version": {"type": ["string", "null"]}
              }
            }
          ]
        }
      }
    },
    "conditions": {
      "type": "object",
      "description": "Condition semantics (tempdoc 346): A=file tools only, B=file+JustSearch, C=JustSearch only."
    },
    "measured": {
      "type": "object",
      "description": "{corpus_slug: {agent_model: cell}} — one paired comparison cell per (corpus, model).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["accuracy", "provider_cache_creation_input_tokens", "tokens_unique", "cost_usd", "identity", "primary_arm"],
          "properties": {
            "accuracy": {
              "type": "object",
              "description": "Binary outcome via McNemar's paired test over pooled (seed, qid) observations.",
              "required": ["baseline", "with_tool", "delta", "mcnemar_p"],
              "properties": {
                "baseline": { "type": "number" },
                "with_tool": { "type": "number" },
                "delta": { "type": "number" },
                "mcnemar_p": { "type": "number" },
                "mcnemar_test": { "type": "string" },
                "n_with_tool_fixes": { "type": "integer" },
                "n_with_tool_breaks": { "type": "integer" },
                "seed_envelope_baseline": { "type": "object" },
                "seed_envelope_with_tool": { "type": "object" }
              }
            },
            "provider_cache_creation_input_tokens": {
              "type": "object",
              "description": "Provider-reported cache_creation_input_tokens; not a universal unique-content count.",
              "required": ["baseline", "with_tool", "delta_mean", "delta_ci95"]
            },
            "identity": {
              "type": "object",
              "required": ["corpus_signature", "requested_model_alias", "resolved_provider_model"]
            },
            "primary_arm": {"enum": ["addition_b", "substitution_c"]},
            "tokens_unique": {
              "type": "object",
              "description": "Deprecated v1 alias for provider_cache_creation_input_tokens.",
              "properties": {
                "baseline": { "type": "object" },
                "with_tool": { "type": "object" },
                "delta_mean": { "type": "number" },
                "delta_ci95": { "type": "array" }
              }
            },
            "cost_usd": { "type": "object" },
            "turns": { "type": "object" },
            "n_paired_observations": { "type": "integer" },
            "leak_suspect_cells": {
              "type": "array",
              "description": "Answer-key leak detection backstop (tempdoc 624 §As-built #7). Each entry is a (seed, qid) observation EXCLUDED from this arm's paired statistics because a tool-call scan flagged a Read/Glob path naming the eval's own gold-answer file (queries.json) on one side of the pair. Empty when nothing was flagged. Only covers the bespoke stream-json harness path (agent_retrieval_eval.run_agent_eval) today -- the Inspect-AI opt-in path does not capture tool_calls, so a run executed there reports an empty list regardless of whether a leak occurred.",
              "items": {
                "type": "object",
                "properties": {
                  "seed": {},
                  "qid": { "type": "string" },
                  "baseline_leak_suspect": { "type": "boolean" },
                  "with_tool_leak_suspect": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "seed_count": { "type": "integer", "description": "Distinct seeds aggregated (the statistical power knob; >=5 is the literature floor)." },
    "confidence_tier": { "type": "string", "enum": ["A", "B", "C"], "description": "Honest confidence label carried through (mirrors 623/the register)." },
    "coverage": {
      "type": "object",
      "description": "First-class negative space (mirrors 623 release.coverage).",
      "required": ["measures", "does_not_measure", "contamination_class"],
      "properties": {
        "measures": { "type": "string" },
        "does_not_measure": { "type": "string", "description": "States the SUBSTITUTION-vs-ADDITION caveat (C-4)." },
        "contamination_class": { "type": "string", "enum": ["public-pre-cutoff", "post-cutoff", "private-synthetic", "unknown"], "description": "Corpus contamination class (C-5) as a first-class label, not a footnote." }
      }
    },
    "comparability": {"type": "object"},
    "tool_call_assertions": {"type": "object"},
    "statistical_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "estimands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "per_protocol", "intention_to_treat"],
      "properties": {
        "primary": {"const": "intention_to_treat"},
        "per_protocol": {
          "type": "object", "required": ["role"],
          "properties": {"role": {"const": "secondary"}}
        },
        "intention_to_treat": {
          "type": "object", "additionalProperties": false, "required": ["strata"],
          "properties": {"strata": {"type": "array", "items": {"$ref": "#/definitions/ittStratum"}}}
        },
        "completion": {
          "type": "object",
          "description": "tempdoc 768 D4 / 762 §T4: the third of the ITT/per-protocol/completion triple. Per-arm completion rate (finished within budget; a budget-exhausted cell is a non-completion under exhaustion-as-failure) that separates the ITT accuracy from the per-protocol accuracy. NOT required: pre-768 records omit it; always emitted on fresh compositions.",
          "required": ["role", "strata"],
          "properties": {
            "role": {"const": "secondary"},
            "source": {"const": "measured"},
            "strata": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stratum_id", "corpus", "model", "by_arm"],
                "properties": {
                  "stratum_id": {"type": ["string", "null"]},
                  "corpus": {"type": ["string", "null"]},
                  "model": {"type": ["string", "null"]},
                  "by_arm": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["n_expected", "n_attempted", "n_completed", "completion_rate"],
                      "properties": {
                        "n_expected": {"type": "integer", "minimum": 0},
                        "n_attempted": {"type": "integer", "minimum": 0},
                        "n_completed": {"type": "integer", "minimum": 0},
                        "n_exhausted": {"type": "integer", "minimum": 0},
                        "completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "claim_verdict": {
      "type": "object",
      "required": ["status", "accepted", "outcome", "stratum_outcomes", "policy_id", "policy_hash", "gates", "reasons"],
      "properties": {
        "outcome": {"enum": ["benefit", "harm", "null", "adoption-only", "inconclusive"]},
        "stratum_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stratum_id", "corpus", "model", "outcome", "gates"],
            "properties": {"gates": {"type": "object"}}
          }
        }
      }
    },
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "object",
      "description": "Present ONLY when this record is a corrected re-derivation of a prior record composed from the same identity-bearing inputs (tempdoc 624 Design 1) -- e.g. a queries.json-leak exclusion, a condition-C re-check, or a judge-rescoring pass. Absent on an original composition. `agent_cohort_key`/`pairing_key` are deliberately invariant across the original and every corrected version, so they cannot themselves distinguish 'this composed record' from 'that other composition of the identical cohort' -- `supersedes` therefore references a file path, not an in-record identity.",
      "required": ["supersedes", "reason", "changed_fields"],
      "properties": {
        "supersedes": { "type": "string", "description": "Relative path (from this record's own file) to the prior record's JSON file that this record corrects." },
        "reason": { "type": "string", "enum": ["leak_correction", "judge_rescore", "reseed", "other"], "description": "Closed set naming WHY this revision exists." },
        "changed_fields": { "type": "array", "items": { "type": "string" }, "description": "Dot-path names of the top-level/nested fields that materially changed vs. the superseded record. Caller-specified, not auto-diffed -- accurate, not required to be exhaustive." }
      }
    },
    "external_baselines": {
      "type": "object",
      "description": "CITED external constants (FRAMES, BFCL-V4, CodeScaleBench, PHMForge, A-RAG) — never a projection of our runs; pinned by source+version.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "claim": { "type": "string" },
            "value": {},
            "source_url": { "type": "string" },
            "version": { "type": "string" },
            "self_reproduced": { "const": false }
          }
        }
      }
    }
  }
}
