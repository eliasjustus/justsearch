{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssot.justsearch/v1/schemas/lifecycle-snapshot.v1.json",
  "title": "JustSearch lifecycle snapshot",
  "type": "object",
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "LIFECYCLE_STATE_STARTING",
        "LIFECYCLE_STATE_READY",
        "LIFECYCLE_STATE_DEGRADED",
        "LIFECYCLE_STATE_ERROR",
        "LIFECYCLE_STATE_STOPPING",
        "LIFECYCLE_STATE_STOPPED"
      ]
    },
    "component": {
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "reason_code": { "type": ["string", "null"] }
      },
      "required": ["state"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "lifecycle": {
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "reason_code": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "head": { "$ref": "#/$defs/component" },
        "worker": { "$ref": "#/$defs/component" },
        "inference": { "$ref": "#/$defs/component" }
      },
      "required": ["head", "worker", "inference"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "observed_at", "lifecycle", "components"],
  "additionalProperties": true
}
