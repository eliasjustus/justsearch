    },
    "jobs" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "attempts" : {
            "type" : "integer"
          },
          "collection" : {
            "type" : "string"
          },
          "errorMessage" : {
            "type" : "string"
          },
          "lastUpdatedMs" : {
            "type" : "integer"
          },
          "pathHash" : {
            "type" : "string"
          },
          "retryAfterMs" : {
            "type" : "integer"
          },
          "scanId" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          }
        },
        "required" : [ "attempts", "collection", "errorMessage", "lastUpdatedMs", "pathHash", "retryAfterMs", "scanId", "state" ]
      }
    }
  },
